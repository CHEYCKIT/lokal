<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone helper executable, NOT a Node native addon.

    Background: an earlier attempt (see git history / closed upstream PR
    "feat/windows-smtc-shuffle-repeat-upstream") implemented this same SMTC
    shuffle/repeat interop as a Rust N-API native addon (a compiled .node
    file loaded directly into Electron's renderer/main process). That
    approach never worked in packaged (asar) builds - the .node file
    failed to load, most likely an N-API ABI mismatch against the
    Node/Electron version actually bundled in the packaged app, or an
    asar-unpack path issue. That failure mode is specific to native Node
    addons.

    This project sidesteps that entire failure class by NOT being a Node
    addon at all: it's an ordinary, self-contained Windows executable that
    Electron's main process spawns as a plain child process (see
    electron/ipc/smtc.js). There is no Node ABI to match and nothing to
    asar-unpack - electron-builder ships this exe as a real file on disk
    via `extraResources`, and Electron just runs it like any other external
    tool (the way it already shells out to yt-dlp/ffmpeg).

    Why .NET Framework 4.8 specifically: it has built-in WinRT projection
    support (via Microsoft.Windows.SDK.Contracts, see the PackageReference
    below) matching the proven approach used by other non-UWP Win32 apps
    that bind their own SystemMediaTransportControls to a window handle
    (e.g. datasone/MPVMediaControl). .NET Framework 4.8 also ships in the
    box on any up-to-date Windows 10/11 install, so there's no runtime to
    bundle alongside the exe.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SmtcBridge</RootNamespace>
    <AssemblyName>SmtcBridge</AssemblyName>
    <!-- Application.Run() gives us a real Win32 message pump on the STA
         thread, which WinRT TypedEventHandler callbacks (ShuffleEnabledChangeRequested,
         AutoRepeatModeChangeRequested) need in order to be delivered reliably. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Projects the Windows Runtime APIs (Windows.Media.SystemMediaTransportControls,
         Windows.Foundation.TypedEventHandler, etc.) into this classic .NET Framework
         project without needing a hand-authored <Reference> HintPath to a specific
         Windows Kits install on the build machine - the winmd + the
         System.Runtime.WindowsRuntime marshalling support are both pulled in by this
         single NuGet package, so the build is reproducible on any CI runner regardless
         of which exact Windows SDK version happens to be preinstalled. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.4948" />
  </ItemGroup>

</Project>
